# PostgreSQL Connection String
# Railway/Render will provide this automatically as DATABASE_URL
# For local dev with PostgreSQL:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=plancrick;Username=postgres;Password=postgres

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# Allowed CORS Origins (comma-separated)
# Update this with your Vercel frontend URL
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
